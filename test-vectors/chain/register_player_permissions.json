{
  "name": "register_player_permissions",
  "description": "RegisterPlayer 仅 admin/system；重复注册（新 idemKey）抛 PLAYER_EXISTS",
  "steps": [
    {
      "op": "registerPlayer",
      "as": "alice",
      "args": { "playerId": "dave" },
      "expect": { "ok": false, "code": "FORBIDDEN" }
    },
    {
      "op": "registerPlayer",
      "as": "admin",
      "args": { "playerId": "dave" },
      "expect": { "ok": true }
    },
    {
      "op": "registerPlayer",
      "as": "admin",
      "args": { "playerId": "dave" },
      "expect": { "ok": false, "code": "PLAYER_EXISTS" }
    }
  ]
}
