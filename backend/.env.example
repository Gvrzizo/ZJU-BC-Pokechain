# --- server ---
PORT=3000
NODE_ENV=development
# CORS whitelist (comma separated)
CORS_ORIGINS=http://localhost:8080

# --- postgres (chaincode-api §7 tables; TypeORM synchronize=true, course env) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokechain

# --- redis (refresh whitelist / nonces / rate limit / rooms / cache) ---
REDIS_URL=redis://localhost:6379

# --- jwt (access 15m, refresh 7d) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SEC=604800

# --- fabric ---
# true  -> in-process MockChainAdapter (no Fabric network needed, full demo; DEFAULT)
# false -> real network: the gateway connects to the peer directly via the
#          FABRIC_PEER_* settings below (endpoint + TLS cert + host alias) and
#          enrolls users via the Org1 CA (FABRIC_CA_*). Values below already
#          match this repo's network/ (org1.pokechain.com).
FABRIC_MOCK=true
FABRIC_CHANNEL=gamechannel
FABRIC_CHAINCODE=pokemoncc
# [DEPRECATED] not consumed by the current implementation — FabricGatewayService
# builds the gRPC connection from FABRIC_PEER_* below. Kept for reference only.
# FABRIC_CONNECTION_PROFILE=../network/organizations/connection-org1.json
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.pokechain.com
FABRIC_PEER_TLS_CERT_PATH=../network/organizations/peerOrganizations/org1.pokechain.com/peers/peer0.org1.pokechain.com/tls/ca.crt
FABRIC_CA_URL=https://localhost:7054
FABRIC_CA_NAME=ca.org1.pokechain.com
FABRIC_CA_TLS_CERT_PATH=../network/organizations/fabric-ca/org1/tls-cert.pem
FABRIC_CA_ADMIN_ID=admin
FABRIC_CA_ADMIN_SECRET=adminpw
FABRIC_SYSTEM_USER=system
FABRIC_SYSTEM_MSP_ID=Org1MSP
FABRIC_CERT_STORE_DIR=.fabric-certs

# AES-256-GCM key (64 hex chars) for encrypting enrolled user keys at rest
CERT_ENC_KEY=

# --- minio ---
MINIO_MOCK=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pokechain-assets
MINIO_PUBLIC_BASE_URL=

# --- battle engine ---
BATTLE_TURN_TIMEOUT_MS=30000
BATTLE_DISCONNECT_TIMEOUT_MS=60000
# both players must reach the battle screen within this window after activation,
# otherwise the absent party forfeits (its wager goes to the opponent)
BATTLE_ENTRY_GRACE_MS=90000
# RESULT_SUBMITTED 后等不到双方确认时的兜底结算（默认 2 分钟；前端双方会自动确认）
BATTLE_SETTLE_FALLBACK_MS=120000
# ACTIVE 房间没有对应引擎且超过该时长 → 视为重启残留，大厅隐藏并后台对账
BATTLE_RECONCILE_STALE_MS=600000
# secp256k1 PKCS8 PEM for signing battle results; generated at boot when empty
SERVER_SIGNING_KEY=
